# ── Option A: Google Places API (recommended) ──────────────────────────────────
# Free $200/month credit (~40,000 searches). Get key at console.cloud.google.com
# Enable "Places API" then create an API key under Credentials.
# GOOGLE_PLACES_API_KEY=AIza...

# ── Option B: SerpAPI (easiest to start) ──────────────────────────────────────
# 100 free searches/month, no billing required. Sign up at serpapi.com
# SERPAPI_KEY=your_key_here
